{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "leetcode-ts: Debug",
      "program": "${workspaceFolder}/leetcode-ts/src/main.ts",
      "outFiles": [
        "${workspaceFolder}/leetcode-ts/dist/**/*.js",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "leetcode-rs: Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/leetcode-rs/target/debug/leetcode.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/leetcode-rs",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "CargoBuild"
    },
    {
      "name": "leetcode-csharp: Debug",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/leetcode-csharp/LeetCode/LeetCode.csproj",
    },
    {
      "name": "leetcode-py: Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "leetcode-java: Debug",
      "request": "launch",
      "mainClass": "${workspaceFolder}/leetcode-java/src/main/java/org/zerox201/App.java"
    }
  ]
}